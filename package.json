{
  "name": "sevens-and-nines",
  "productName": "Sevens and Nines",
  "version": "1.0.0",
  "description": "Classic card game: Sevens, Nines, Parliament and Fan Tan",
  "author": "Anton Mykhailov",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist:appimage": "npm run build && electron-builder --linux AppImage",
    "dist:deb": "npm run build && electron-builder --linux deb",
    "dist:snap": "npm run build && electron-builder --linux snap"
  },
  "build": {
    "appId": "io.snapcraft.sevens-and-nines",
    "productName": "Sevens and Nines",
    "executableName": "sevens-and-nines",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "desktop/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "snap"
      ],
      "category": "Game",
      "icon": "desktop/icon.svg"
    },
    "snap": {
      "grade": "stable",
      "confinement": "strict",
      "summary": "Classic card game: Sevens, Nines, Parliament and Fan Tan",
      "category": "Game"
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.46.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
